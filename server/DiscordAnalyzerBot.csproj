<Project Sdk="Microsoft.NET.Sdk">

  <!-- Серверная версия бота /анализ для Linux (.NET 8, без окна) -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>DiscordAnalyzerBot</AssemblyName>
    <RootNamespace>DiscordAnalyzer</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <InvariantGlobalization>false</InvariantGlobalization>
    <NoWarn>SYSLIB0014;CS0618;CS4014;CS0168;CS0219;CS1998</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../src/Core.cs" />
    <Compile Include="../src/Analyzer.cs" />
    <Compile Include="../src/HtmlReport.cs" />
    <Compile Include="../src/BotService.cs" />
    <Compile Include="../src/SelfTest.cs" />
    <Compile Include="../src/ServerMain.cs" />
  </ItemGroup>

</Project>
